# Copie este arquivo para .env.local e preencha

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
NEXT_PUBLIC_SITE_URL=https://www.aliancabanhada.com.br

# PIX manual (fallback se Mercado Pago não estiver configurado)
NEXT_PUBLIC_PIX_KEY=seu-email-ou-chave-pix
NEXT_PUBLIC_PIX_KEY_TYPE=email
NEXT_PUBLIC_PIX_NAME=Aliança Banhada

# Frete fallback (quando Melhor Envio estiver indisponível)
NEXT_PUBLIC_SHIPPING_FLAT=24.9

# Mercado Pago Checkout Pro (somente servidor)
# MERCADO_PAGO_ACCESS_TOKEN=TEST-xxx ou APP_USR-xxx
# MERCADO_PAGO_WEBHOOK_SECRET=assinatura_do_painel
# MERCADO_PAGO_ENV=sandbox
# Webhook URL: https://www.aliancabanhada.com.br/api/webhooks/mercado-pago

# Melhor Envio (somente servidor)
# MELHOR_ENVIO_TOKEN=Bearer_token_oauth
# MELHOR_ENVIO_ENV=sandbox
# MELHOR_ENVIO_ORIGIN_CEP=88047022
# MELHOR_ENVIO_WIDTH_CM=16
# MELHOR_ENVIO_HEIGHT_CM=4
# MELHOR_ENVIO_LENGTH_CM=11
# MELHOR_ENVIO_WEIGHT_KG=0.3
# MELHOR_ENVIO_USER_AGENT=Alianca Banhada (seu@email.com)

# E-mails (Resend)
# RESEND_API_KEY=re_xxx
# RESEND_FROM=Aliança Banhada <contato@aliancabanhada.com.br>
# RESEND_REPLY_TO=jaimegsantosjroficial@gmail.com
# ORDER_NOTIFY_EMAIL=jaimegsantosjroficial@gmail.com

# Service role (webhook MP + validação de cupom)
# SUPABASE_SERVICE_ROLE_KEY=
